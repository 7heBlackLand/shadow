#!/bin/bash
# Drop the full Firefox browser to shrink the ISO below 2 GiB.
#
# kali-desktop-core hard-Depends on "firefox-esr | firefox", so the real browser
# is pulled in automatically and cannot be excluded via --apt-recommends false.
# We satisfy that dependency with a tiny dummy package, then purge the real
# Firefox. XFCE remains fully functional; only the preinstalled browser is gone
# (users can "apt install firefox-esr" later if they want one). This does not
# touch the boot system, kernel, initramfs, live-boot, GRUB/EFI, or build.sh.
set -e

apt-get update -qq
apt-get install -y --no-install-recommends equivs

cat > /tmp/shadow-browser-dummy.control <<'CTRL'
Section: net
Priority: optional
Standards-Version: 3.9.2
Package: shadow-browser-dummy
Version: 1.0
Provides: firefox-esr, firefox, www-browser
Description: Dummy provider for the browser dependency (no real Firefox shipped)
CTRL

cd /tmp
equivs-build /tmp/shadow-browser-dummy.control
dpkg -i /tmp/shadow-browser-dummy_1.0_all.deb

# Now the dependency is satisfied by the dummy; remove the real browser.
apt-get purge -y --auto-remove firefox-esr || true

# Clean up the build tooling we only needed for the dummy.
apt-get purge -y --auto-remove equivs dpkg-dev >/dev/null 2>&1 || true

rm -f /tmp/shadow-browser-dummy.control /tmp/shadow-browser-dummy_1.0_all.deb
