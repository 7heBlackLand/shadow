<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <locale>
    <language>en_US.UTF-8</language>
  </locale>
  <theme>
    <name>Breeze</name>
    <titleLayout>NLIMC</titleLayout>
    <font place="ActiveWindow"><name>DejaVu Sans</name><size>11</size></font>
    <font place="Menu"><name>DejaVu Sans</name><size>11</size></font>
    <font place="OSD"><name>DejaVu Sans</name><size>11</size></font>
  </theme>
  <desktops>
    <number>4</number>
    <names>
      <name>1</name>
      <name>2</name>
      <name>3</name>
      <name>4</name>
    </names>
    <firstdesk>1</firstdesk>
  </desktops>
  <resize>
    <drawContents>yes</drawContents>
  </resize>
  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
    <underMouse>no</underMouse>
    <mode>sloppy</mode>
  </focus>
  <placement>
    <policy>Smart</policy>
    <center>yes</center>
  </placement>
  <margins>
    <desktop>0</desktop>
  </margins>
  <keyboard>
    <chainQuitKey>C-g</chainQuitKey>
    <keybind key="Super-Space"><action name="Execute"><command>dmenu_run</command></action></keybind>
    <keybind key="Super-Return"><action name="Execute"><command>st</command></action></keybind>
    <keybind key="Super-E"><action name="Execute"><command>thunar</command></action></keybind>
    <keybind key="Super-D"><action name="ToggleShowDesktop"/></keybind>
    <keybind key="Super-1"><action name="Desktop"><desktop>1</desktop></action></keybind>
    <keybind key="Super-2"><action name="Desktop"><desktop>2</desktop></action></keybind>
    <keybind key="Super-3"><action name="Desktop"><desktop>3</desktop></action></keybind>
    <keybind key="Super-4"><action name="Desktop"><desktop>4</desktop></action></keybind>
    <keybind key="Super-Tab"><action name="NextWindow"/></keybind>
    <keybind key="Super-F4"><action name="Close"/></keybind>
    <keybind key="Alt-F4"><action name="Close"/></keybind>
    <keybind key="Print"><action name="Execute"><command>scrot</command></action></keybind>
    <keybind key="XF86PowerOff"><action name="Execute"><command>systemctl poweroff</command></action></keybind>
    <keybind key="XF86Reboot"><action name="Execute"><command>systemctl reboot</command></action></keybind>
    <keybind key="Super-L"><action name="Execute"><command>light-locker-command -l</command></action></keybind>
    <keybind key="Super-Q"><action name="Execute"><command>oblogout</command></action></keybind>
    <keybind key="Control-Alt-Delete"><action name="Execute"><command>systemctl reboot</command></action></keybind>
  </keyboard>
  <mouse>
    <dragThreshold>1</dragThreshold>
    <doubleClickTime>200</doubleClickTime>
    <context name="Frame">
      <mousebind button="A-Left" action="Press"><action name="Focus"/></mousebind>
      <mousebind button="A-Left" action="Drag"><action name="Move"/></mousebind>
      <mousebind button="A-Right" action="Press"><action name="Focus"/></mousebind>
      <mousebind button="A-Right" action="Drag"><action name="Resize"/></mousebind>
    </context>
    <context name="Titlebar">
      <mousebind button="Left" action="Press"><action name="Focus"/></mousebind>
      <mousebind button="Left" action="Drag"><action name="Move"/></mousebind>
      <mousebind button="Left" action="DoubleClick"><action name="ToggleMaximize"/></mousebind>
      <mousebind button="Right" action="Press"><action name="Focus"/></mousebind>
      <mousebind button="Right" action="Press"><action name="ShowMenu"><menu>client-menu</menu></action></mousebind>
    </context>
    <context name="Client">
      <mousebind button="Left" action="Press"><action name="Focus"/></mousebind>
      <mousebind button="Middle" action="Press"><action name="Focus"/></mousebind>
      <mousebind button="Right" action="Press"><action name="Focus"/></mousebind>
    </context>
    <context name="Root">
      <mousebind button="Right" action="Press"><action name="ShowMenu"><menu>root-menu</menu></action></mousebind>
      <mousebind button="Middle" action="Press"><action name="ShowMenu"><menu>client-list-combined-menu</menu></action></mousebind>
      <mousebind button="Left" action="Press"><action name="Execute"><command>dmenu_run</command></action></mousebind>
    </context>
  </mouse>
  <applications>
    <application class="*">
      <decor>yes</decor>
    </application>
  </applications>
</openbox_config>
