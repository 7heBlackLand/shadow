#!/bin/sh
# Shadow desktop session launcher (Openbox based)
export XDG_CURRENT_DESKTOP=Shadow
export XDG_SESSION_DESKTOP=shadow
export DESKTOP_SESSION=shadow
export GTK_THEME=Breeze
export GTK2_RC_FILES=/etc/gtk-2.0/gtkrc:/home/$USER/.gtkrc-2.0
export QT_QPA_PLATFORMTHEME=gtk3
export QT_STYLE_OVERRIDE=Breeze
export XCURSOR_THEME=breeze_cursors
export XCURSOR_SIZE=24
exec openbox --startup /etc/xdg/openbox/autostart
